    <string name="toolbar_title">Clean Your Mobile</string>

    <!-- Main screen chrome -->
    <string name="search_hint">Search apps</string>
    <string name="clear">Clear</string>
    <string name="disable">Disable</string>
    <string name="recheck">Re-check</string>
    <string name="open_shizuku">Open Shizuku</string>
    <string name="grant_access">Grant access</string>
    <string name="cancel">Cancel</string>
    <string name="close">Close</string>
    <string name="ok">OK</string>
    <string name="restore">Restore</string>
    <string name="appearance">Appearance</string>

    <!-- Startup failures -->
    <string name="fatal_cannot_start">Cannot start: %1$s</string>
    <string name="fatal_guard_truncated">Cannot start: the never-touch list looks truncated (%1$d entries). Refusing to run without a guard.</string>
    <string name="db_schema_mismatch">debloat_db.json declares schema_version %1$s; this build speaks %2$s.x. Refusing to guess.</string>
    <string name="db_essentials_empty">The never-touch list parsed as empty. Refusing to continue.</string>

    <!-- Scan summary and selection -->
    <string name="summary">%1$d installed · %2$d recognised · %3$d protected · %4$d unrated · %5$d already off · %6$d regular apps left alone</string>
    <string name="selected_count">%1$d selected</string>

    <!-- Shizuku states -->
    <string name="shizuku_not_installed">Shizuku is not installed. It is what lets this app change apps without root.\n\nGet the GitHub release from github.com/RikkaApps/Shizuku - the Play Store build is older and has no Android 16 support.</string>
    <string name="shizuku_not_running">Shizuku is installed but not running.\n\nOpen it and start the service: pair over Wireless debugging on Android 11+, or start it from a computer over ADB. Android clears it on every reboot.</string>
    <string name="shizuku_needs_permission">Shizuku is running and this app needs your permission to use it.</string>
    <string name="shizuku_not_connected">Shizuku is not connected</string>

    <!-- Confirm and run -->
    <plurals name="confirm_disable_title">
        <item quantity="one">Disable %1$d app?</item>
        <item quantity="other">Disable %1$d apps?</item>
    </plurals>
    <string name="confirm_disable_message">They are disabled, not uninstalled. Nothing is deleted and Restore puts them back.\n\nA snapshot of the phone is saved first.</string>
    <string name="confirm_disable_more">\n…and %1$d more</string>
    <string name="run_refused">%1$s: refused, %2$s</string>
    <string name="run_failed">%1$s: %2$s</string>
    <string name="run_stopped_consecutive">Stopped after %1$d failures in a row — something systemic changed rather than one awkward app.</string>
    <string name="run_package_service_dead">The package service stopped answering — stopping here.</string>
    <string name="run_done_title">Done</string>
    <string name="run_problems_title">Finished with problems</string>
    <string name="run_result">Disabled: %1$d\nFailed: %2$d</string>

    <!-- Overflow menu -->
    <string name="menu_restore_all">Restore all</string>
    <string name="menu_export_backup">Export backup</string>
    <string name="menu_export_preset">Export preset</string>
    <string name="menu_import_preset">Import preset</string>

