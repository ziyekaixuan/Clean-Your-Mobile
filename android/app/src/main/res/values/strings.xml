    <!-- Failure explanations -->
    <string name="fail_vendor_rom">blocked by the vendor ROM (would need root, which this app will not use)</string>
    <string name="fail_component_state">the ROM will not let a shell change this package - vendor-protected, and no tool gets past it without root</string>
    <string name="fail_uninstall_refused">the ROM refused the uninstall - try disable instead</string>
